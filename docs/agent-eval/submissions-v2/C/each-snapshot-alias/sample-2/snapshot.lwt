# each 的浅快照与记录别名语义
record Box { value };

let values = [1, 2, 3];
let iterations = 0;

each (v in values) {
    push(values, 99);
    iterations = iterations + 1;
}

emit "iterations " + str(iterations);

let b = Box{value: 1};
let alias = b;
alias.value = 9;

emit "b.value " + str(b.value);
emit "b == alias " + str(b == alias);
