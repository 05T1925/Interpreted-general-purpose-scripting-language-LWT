# pipeline.lwt —— 生产者/消费者与失败任务（默认 fifo 策略下输出恒定）
fn produce(ch) {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn boom() {
    throw "task failed";
}

let ch = channel();
let producer = spawn produce(ch);

let total = 0;
let value = receive(ch);
while (value != null) {
    total = total + value;
    value = receive(ch);
}
emit "sum " + str(total);

let bad = spawn boom();
attempt {
    join(bad);
} recover (problem) {
    emit "caught:" + problem.message;
}
