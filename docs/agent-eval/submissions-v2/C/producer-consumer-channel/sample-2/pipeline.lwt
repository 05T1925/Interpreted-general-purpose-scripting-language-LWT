let ch = channel();

fn produce() {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn boom() {
    throw "task failed";
}

let producer = spawn produce();
let total = 0;
let item = receive(ch);
while (item != null) {
    total = total + item;
    item = receive(ch);
}
emit "sum " + str(total);

let t = spawn boom();
attempt {
    join(t);
} recover (problem) {
    emit "caught:" + problem.message;
}
