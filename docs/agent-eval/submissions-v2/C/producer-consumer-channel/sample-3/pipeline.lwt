# pipeline.lwt —— 生产者/消费者通道 + 任务错误捕获
# 规范依据：docs/language-spec.md §11.2/§11.3/§11.5/§11.6/§11.7、§10.6

fn produce(ch) {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn boom() {
    throw "task failed";
}

let ch = channel();
let producer = spawn produce(ch);

let sum = 0;
let value = receive(ch);
while (value != null) {
    sum = sum + value;
    value = receive(ch);
}
emit "sum " + str(sum);

let t = spawn boom();
attempt {
    join(t);
} recover (p) {
    emit "caught:" + p.message;
}
