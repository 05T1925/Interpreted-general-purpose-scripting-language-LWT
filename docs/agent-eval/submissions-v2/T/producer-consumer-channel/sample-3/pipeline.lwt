# pipeline.lwt — deterministic producer/consumer over an unbounded FIFO channel,
# followed by a join/recover demo for a failing task.

let ch = channel();

fn produce() {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn explode() {
    throw "task failed";
}

let producer = spawn produce();

let sum = 0;
let value = receive(ch);
while (value != null) {
    sum = sum + value;
    value = receive(ch);
}
emit "sum " + str(sum);

let t = spawn explode();
attempt {
    join(t);
} recover (p) {
    emit "caught:" + p.message;
}
