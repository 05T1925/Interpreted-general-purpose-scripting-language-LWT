# producer/consumer over a deterministic FIFO channel, then join-error recovery

fn produce(ch) {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn failer() {
    throw "task failed";
}

let ch = channel();
let producer = spawn produce(ch);

let total = 0;
let value = receive(ch);
while (value != null) {
    total = total + value;
    value = receive(ch);
}
emit "sum " + str(total);

let bad = spawn failer();
attempt {
    join(bad);
} recover (p) {
    emit "caught:" + p.message;
}
