# cleanup.lwt — throw / attempt-recover-finally 演示（LWT 0.3.0 规范 §10.6）

fn charge(n) {
    when (n < 0) {
        throw error("Validation", "negative amount");
    }
    return n * 2;
}

attempt {
    emit str(charge(-5));
} recover (problem) {
    emit problem.category;
    emit problem.message;
} finally {
    emit "cleanup";
}

emit str(charge(4));
