{
  "Function declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:parameters}) {",
      "    ${3:body}",
      "}"
    ],
    "description": "Declare a top-level LWT function."
  },
  "Record declaration": {
    "prefix": "record",
    "body": [
      "record ${1:Name} {",
      "    ${2:field}",
      "};"
    ],
    "description": "Declare a top-level LWT record type."
  },
  "When branch": {
    "prefix": "when",
    "body": [
      "when (${1:condition}) {",
      "    ${2:body}",
      "} otherwise {",
      "    ${3:body}",
      "}"
    ],
    "description": "Create a conditional branch with explicit blocks."
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${2:body}",
      "}"
    ],
    "description": "Create a while loop."
  },
  "Each loop": {
    "prefix": "each",
    "body": [
      "each (${1:item} in ${2:items}) {",
      "    ${3:body}",
      "}"
    ],
    "description": "Iterate over an array snapshot."
  }
}
