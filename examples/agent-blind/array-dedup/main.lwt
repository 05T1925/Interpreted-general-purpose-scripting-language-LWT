let values = [3, 1, 3, 2, 1];
let result = [];
let i = 0;
while (i < len(values)) {
    let seen = false;
    let j = 0;
    while (j < len(result)) {
        when (result[j] == values[i]) {
            seen = true;
        }
        j = j + 1;
    }
    when (not seen) {
        push(result, values[i]);
    }
    i = i + 1;
}
emit result;
