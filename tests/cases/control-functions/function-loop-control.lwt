fn score() {
  let sum = 0;
  let n = 0;
  while (n < 5) {
    n = n + 1;
    when (n == 2) { continue; }
    when (n == 4) { break; }
    sum = sum + n;
  }
  each (item in [1, 2, 3]) {
    when (item == 2) { continue; }
    sum = sum + item;
    when (item == 3) { break; }
  }
  return sum;
}
emit score();
emit "after";
