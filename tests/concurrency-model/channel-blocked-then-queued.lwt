# S46 regression for the S45 duplicate-delivery defect: a blocked receiver
# takes the handoff value, then queued values, in FIFO order, then null.
fn produce(ch) {
    send(ch, 1);
    send(ch, 2);
    close(ch);
}

let ch = channel();
let t = spawn produce(ch);
let first = receive(ch);
let second = receive(ch);
let third = receive(ch);
join(t);
emit str(first) + "," + str(second) + "," + str(third);
