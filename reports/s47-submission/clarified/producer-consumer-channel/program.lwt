# pipeline.lwt
# 生产者任务向通道 ch 依次发送 1、2、3 后关闭通道；
# 主任务用阻塞 receive 循环累加，直到取的 null 为止，输出 sum 6。
# 随后派生一个 throw "task failed" 的任务，用 attempt/join 捕获并输出消息。
# 默认 fifo 策略下调度唯一确定，因此每次输出完全一致。

fn produce(ch) {
    send(ch, 1);
    send(ch, 2);
    send(ch, 3);
    close(ch);
}

fn boom() {
    throw "task failed";
}

let ch = channel();
let producer = spawn produce(ch);

let total = 0;
let v = receive(ch);
while (v != null) {
    total = total + v;
    v = receive(ch);
}
emit "sum " + str(total);

let t = spawn boom();
attempt {
    join(t);
} recover (p) {
    emit "caught:" + p.message;
}
